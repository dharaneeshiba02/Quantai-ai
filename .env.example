# ============================================================
# QuantAI AI — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git. Credentials never reach the LLM.
# ============================================================

# ----- LLM provider ------------------------------------------
LLM_PROVIDER=auto
GROQ_API_KEY=replace_with_your_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=high

# Local Ollama is used for embeddings and schema selection.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5-coder:7b
LLM_FALLBACK_MODEL=qwen2.5-coder:3b
LLM_EMBED_MODEL=nomic-embed-text
LLM_NUM_CTX=4096          # 4096 | 6144 | 8192 (higher = more RAM/VRAM)
LLM_TEMPERATURE_SQL=0
LLM_TEMPERATURE_INSIGHT=0.2
LLM_TIMEOUT_SEC=120
LLM_AUTO_FALLBACK=true    # fall back to smaller model on OOM/timeout

# ----- MySQL (quantai_data — user data) ---------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=YourPassword

# Read-only user (used for all generated SQL)
MYSQL_READONLY_USER=quantai_readonly
MYSQL_READONLY_PASSWORD=YourPassword

# Import user (used only for CSV/Excel import)
MYSQL_IMPORT_USER=quantai_import
MYSQL_IMPORT_PASSWORD=YourPassword

# App user (read/write on quantai_app schema)
MYSQL_APP_USER=quantai_app
MYSQL_APP_PASSWORD=YourPassword

MYSQL_DATA_SCHEMA=quantai_data
MYSQL_APP_SCHEMA=quantai_app

# ----- Privacy / Accuracy -----------------------------------
SCHEMA_ONLY_MODE=false         # true = no sample rows ever sent to model
PII_MASKING_ENABLED=true       # mask PII in sample rows sent to model
PII_COLUMN_PATTERNS=name,email,phone,ssn,address,dob,birth
SAMPLE_ROWS_FOR_LLM=3          # rows from selected columns shown to model
DATE_ANCHOR=data_max           # data_max | today

# ----- Column Selector (wide tables) ------------------------
COLUMN_SELECTOR_TOP_K=20       # top-K columns sent to SQL generator
EMBEDDING_CACHE_DIR=data/embeddings

# ----- Query / Execution ------------------------------------
MAX_QUERY_ROWS_DISPLAY=1000
MAX_EXPORT_ROWS=100000
QUERY_TIMEOUT_MS=30000         # MySQL MAX_EXECUTION_TIME
ACCURACY_MODE=balanced         # fast | balanced | max

# ----- Exports ----------------------------------------------
EXPORTS_DIR=data/exports
EXPORTS_AUTO_EXPIRY_DAYS=7
UPLOADS_DIR=data/uploads
DICTIONARIES_DIR=data/dictionaries

# ----- App --------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_DIST=frontend/dist
SECRET_KEY=change_me_to_random_32_char_string

# ----- Telemetry (must stay false) --------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=disabled
ANONYMIZED_TELEMETRY=false
